<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>☀️ Morning Brief — {{date}}</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.6;
      color: #24292e;
      max-width: 680px;
      margin: 0 auto;
      padding: 20px;
      background-color: #ffffff;
    }
    h1 { font-size: 22px; color: #1a1a2e; border-bottom: 2px solid #e1e4e8; padding-bottom: 8px; margin-top: 0; }
    h2 { font-size: 16px; color: #2d3748; margin-top: 24px; margin-bottom: 8px; padding-bottom: 4px; border-bottom: 1px solid #edf2f7; }
    .action-item { padding: 8px 12px; margin-bottom: 6px; font-size: 14px; border-radius: 0 4px 4px 0; }
    .urgent { background-color: #fff5f5; border-left: 3px solid #e53e3e; }
    .soon { background-color: #fffbeb; border-left: 3px solid #d69e2e; }
    .when-free { background-color: #ebf8ff; border-left: 3px solid #3182ce; }
    .urgency-badge { font-size: 12px; font-weight: 600; margin-right: 6px; }
    .source-tag { font-size: 11px; color: #718096; margin-left: 8px; }
    .learning-item { background-color: #f0fff4; border-left: 3px solid #38a169; padding: 8px 12px; margin-bottom: 6px; font-size: 14px; border-radius: 0 4px 4px 0; }
    .learning-topic { font-weight: 600; color: #276749; }
    .learning-why { color: #4a5568; font-size: 13px; }
    .learning-links { font-size: 12px; margin-top: 4px; }
    .learning-links a { color: #3182ce; text-decoration: none; }
    .signal-item { padding: 6px 0; font-size: 14px; color: #4a5568; border-bottom: 1px solid #f7fafc; }
    .signal-source { font-size: 11px; color: #718096; }
    .drift-alert { background-color: #fefcbf; border-left: 3px solid #d69e2e; padding: 8px 12px; margin-bottom: 6px; font-size: 14px; border-radius: 0 4px 4px 0; }
    .drift-priority { font-weight: 600; color: #975a16; }
    .data-gap { background-color: #fff5f5; border-left: 3px solid #fc8181; padding: 6px 12px; margin-bottom: 6px; font-size: 13px; color: #c53030; border-radius: 0 4px 4px 0; }
    .footer { margin-top: 32px; padding-top: 12px; border-top: 1px solid #e1e4e8; font-size: 12px; color: #a0aec0; }
    .empty-note { font-style: italic; color: #a0aec0; font-size: 14px; }
  </style>
</head>
<body>
  <h1>☀️ Morning Brief — {{date}}</h1>

  {{#if data_gaps.length}}
  <div style="margin-bottom: 16px;">
    {{#each data_gaps}}
    <div class="data-gap">⚠️ {{this}}</div>
    {{/each}}
  </div>
  {{/if}}

  <h2>📋 Today's Plan</h2>
  {{#if todays_plan.length}}
    {{#each todays_plan}}
    <div class="action-item {{urgencyClass this.urgency}}">
      <span class="urgency-badge">{{urgencyEmoji this.urgency}}</span>
      {{this.description}}
      <span class="source-tag">{{this.source}}</span>
    </div>
    {{/each}}
  {{else}}
    <p class="empty-note">No action items for today.</p>
  {{/if}}

  <h2>📚 Recommended Learning</h2>
  {{#if recommended_learning.length}}
    {{#each recommended_learning}}
    <div class="learning-item">
      <div class="learning-topic">{{this.topic}}</div>
      <div class="learning-why">{{this.connection}}</div>
      {{#if this.links.length}}
      <div class="learning-links">
        {{#each this.links}}
        <a href="{{this}}">{{this}}</a>{{#unless @last}} · {{/unless}}
        {{/each}}
      </div>
      {{/if}}
    </div>
    {{/each}}
  {{else}}
    <p class="empty-note">No learning recommendations today.</p>
  {{/if}}

  <h2>📨 Incoming Signals</h2>
  {{#if incoming_signals.length}}
    {{#each incoming_signals}}
    <div class="signal-item">
      {{this.description}}
      <span class="signal-source">— {{this.source}}</span>
    </div>
    {{/each}}
  {{else}}
    <p class="empty-note">No notable signals.</p>
  {{/if}}

  {{#if you_may_forget.length}}
  <h2>⚠️ You May Forget</h2>
    {{#each you_may_forget}}
    <div class="drift-alert">
      <div class="drift-priority">{{this.priority}}</div>
      <div>No activity for {{this.days_inactive}} days — {{this.suggestion}}</div>
    </div>
    {{/each}}
  {{/if}}

  <div class="footer">
    Generated by Dayarc · {{date}}
  </div>
</body>
</html>
