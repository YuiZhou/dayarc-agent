<!DOCTYPE html>
<html lang="{{locale}}"
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>📅 Monthly — {{month}} {{year}}</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Roboto, sans-serif;
      line-height: 1.6;
      color: #24292e;
      max-width: 680px;
      margin: 0 auto;
      padding: 20px;
      background-color: #ffffff;
    }
    h1 { font-size: 22px; color: #1a1a2e; border-bottom: 2px solid #e1e4e8; padding-bottom: 8px; margin-top: 0; }
    h2 { font-size: 16px; color: #2d3748; margin-top: 24px; margin-bottom: 8px; padding-bottom: 4px; border-bottom: 1px solid #edf2f7; }
    .alloc-item { background-color: #f7fafc; border-left: 3px solid #4299e1; padding: 8px 12px; margin-bottom: 6px; border-radius: 0 4px 4px 0; }
    .alloc-area { font-weight: 600; color: #2d3748; font-size: 14px; }
    .alloc-share { font-size: 12px; color: #718096; margin-left: 8px; }
    .alloc-trend { font-size: 12px; padding: 1px 6px; border-radius: 3px; margin-left: 6px; }
    .trend-growing { background-color: #c6f6d5; color: #276749; }
    .trend-shrinking { background-color: #fed7d7; color: #c53030; }
    .trend-stable { background-color: #e2e8f0; color: #4a5568; }
    .trend-new { background-color: #c4f1f9; color: #086f83; }
    .trend-dropped { background-color: #feebc8; color: #975a16; }
    .impact-card { background-color: #faf5ff; border-left: 3px solid #805ad5; padding: 10px 12px; margin-bottom: 10px; border-radius: 0 4px 4px 0; }
    .impact-title { font-weight: 700; color: #44337a; font-size: 15px; margin-bottom: 6px; }
    .impact-line { font-size: 13px; color: #4a5568; margin-top: 3px; }
    .impact-label { font-weight: 600; color: #2d3748; }
    .impact-evidence { font-size: 11px; color: #718096; margin-top: 7px; }
    .stuck-item { background-color: #fff5f5; border-left: 3px solid #e53e3e; padding: 8px 12px; margin-bottom: 6px; border-radius: 0 4px 4px 0; font-size: 14px; }
    .stuck-weeks { font-size: 12px; color: #c53030; font-weight: 600; }
    .learning-item { background-color: #f0fff4; border-left: 3px solid #38a169; padding: 8px 12px; margin-bottom: 6px; border-radius: 0 4px 4px 0; font-size: 14px; }
    .learning-topic { font-weight: 600; color: #276749; }
    .learning-trajectory { font-size: 12px; color: #718096; }
    .learning-rec { font-size: 13px; color: #4a5568; }
    .outlook-item { background-color: #ebf8ff; border-left: 3px solid #3182ce; padding: 6px 12px; margin-bottom: 6px; font-size: 14px; border-radius: 0 4px 4px 0; }
    .data-gap { background-color: #fff5f5; border-left: 3px solid #fc8181; padding: 6px 12px; margin-bottom: 6px; font-size: 13px; color: #c53030; border-radius: 0 4px 4px 0; }
    .footer { margin-top: 32px; padding-top: 12px; border-top: 1px solid #e1e4e8; font-size: 12px; color: #a0aec0; }
    .empty-note { font-style: italic; color: #a0aec0; font-size: 14px; }
    ul { margin: 4px 0 12px 0; padding-left: 20px; }
    li { margin-bottom: 4px; font-size: 14px; color: #4a5568; }
  </style>
</head>
<body>
  <h1>📅 Monthly — {{month}} {{year}}</h1>

  {{#if data_gaps.length}}
  <div style="margin-bottom: 16px;">
    {{#each data_gaps}}
    <div class="data-gap">⚠️ {{this}}</div>
    {{/each}}
  </div>
  {{/if}}

  <h2>📊 Where My Time Went</h2>
  {{#if time_allocation.length}}
    {{#each time_allocation}}
    <div class="alloc-item">
      <span class="alloc-area">{{this.area}}</span>
      <span class="alloc-share">{{pct this.share}}%</span>
      <span class="alloc-trend trend-{{this.trend}}">{{this.trend}}</span>
    </div>
    {{/each}}
  {{else}}
    <p class="empty-note">No allocation data available.</p>
  {{/if}}

  <h2>🌟 Impact Highlights</h2>
  {{#if impact_summaries.length}}
    {{#each impact_summaries}}
    <div class="impact-card">
      <div class="impact-title">{{this.title}}</div>
      <div class="impact-line"><span class="impact-label">Status:</span> {{this.status}}</div>
      <div class="impact-line"><span class="impact-label">Situation:</span> {{this.situation}}</div>
      <div class="impact-line"><span class="impact-label">Task:</span> {{this.task}}</div>
      <div class="impact-line"><span class="impact-label">Action:</span> {{this.action}}</div>
      {{#if this.result}}<div class="impact-line"><span class="impact-label">Result:</span> {{this.result}}</div>{{/if}}
      {{#if this.impact}}<div class="impact-line"><span class="impact-label">Impact:</span> {{this.impact}}</div>{{/if}}
      <div class="impact-evidence">Evidence: {{#each this.source_breadcrumbs}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</div>
    </div>
    {{/each}}
  {{else if accomplishments.length}}
    <ul>
      {{#each accomplishments}}
      <li>{{this}}</li>
      {{/each}}
    </ul>
  {{else}}
    <p class="empty-note">No impact highlights to report.</p>
  {{/if}}

  {{#if persistently_stuck.length}}
  <h2>🚫 Persistently Stuck</h2>
    {{#each persistently_stuck}}
    <div class="stuck-item">
      <span class="stuck-weeks">{{this.weeks_stuck}} weeks</span> — {{this.description}}
    </div>
    {{/each}}
  {{/if}}

  <h2>📚 Learning Progress</h2>
  {{#if learning_progress.length}}
    {{#each learning_progress}}
    <div class="learning-item">
      <div>
        <span class="learning-topic">{{this.topic}}</span>
        <span class="learning-trajectory">{{this.trajectory}}</span>
      </div>
      <div class="learning-rec">{{this.recommendation}}</div>
    </div>
    {{/each}}
  {{else}}
    <p class="empty-note">No learning topics tracked.</p>
  {{/if}}

  <h2>🔮 Next Month's Outlook</h2>
  {{#if outlook_next_month.length}}
    {{#each outlook_next_month}}
    <div class="outlook-item">{{this}}</div>
    {{/each}}
  {{else}}
    <p class="empty-note">No specific outlook for next month.</p>
  {{/if}}

  <div class="footer">
    Generated by Dayarc · {{month}} {{year}}
  </div>
</body>
</html>
