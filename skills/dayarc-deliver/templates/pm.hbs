<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🌙 Evening Wrap-up — {{date}}</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.6;
      color: #24292e;
      max-width: 680px;
      margin: 0 auto;
      padding: 20px;
      background-color: #ffffff;
    }
    h1 {
      font-size: 22px;
      color: #1a1a2e;
      border-bottom: 2px solid #e1e4e8;
      padding-bottom: 8px;
      margin-top: 0;
    }
    h2 {
      font-size: 16px;
      color: #2d3748;
      margin-top: 24px;
      margin-bottom: 8px;
      padding-bottom: 4px;
      border-bottom: 1px solid #edf2f7;
    }
    .theme-label {
      font-weight: 600;
      color: #4a5568;
      font-size: 14px;
      margin-top: 12px;
      margin-bottom: 4px;
    }
    ul {
      margin: 4px 0 12px 0;
      padding-left: 20px;
    }
    li {
      margin-bottom: 4px;
      font-size: 14px;
      color: #4a5568;
    }
    .priority-item {
      background-color: #f7fafc;
      border-left: 3px solid #4299e1;
      padding: 6px 12px;
      margin-bottom: 6px;
      font-size: 14px;
      border-radius: 0 4px 4px 0;
    }
    .unfinished-item {
      background-color: #fffbeb;
      border-left: 3px solid #f6ad55;
      padding: 6px 12px;
      margin-bottom: 6px;
      font-size: 14px;
      border-radius: 0 4px 4px 0;
    }
    .data-gap {
      background-color: #fff5f5;
      border-left: 3px solid #fc8181;
      padding: 6px 12px;
      margin-bottom: 6px;
      font-size: 13px;
      color: #c53030;
      border-radius: 0 4px 4px 0;
    }
    .footer {
      margin-top: 32px;
      padding-top: 12px;
      border-top: 1px solid #e1e4e8;
      font-size: 12px;
      color: #a0aec0;
    }
    .empty-note {
      font-style: italic;
      color: #a0aec0;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <h1>🌙 Evening Wrap-up — {{date}}</h1>

  {{#if data_gaps.length}}
  <p style="color:#a0aec0;font-size:13px;margin-bottom:12px;">⚠️ {{#each data_gaps}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</p>
  {{/if}}

  <h2>📋 What I Did Today</h2>
  {{#if what_i_did.length}}
    {{#each what_i_did}}
    <div class="theme-label">{{this.theme}}{{#if this.total_effort}} ({{this.total_effort}}%){{/if}}</div>
    <ul>
      {{#if this.activities}}
        {{#each this.activities}}
        <li>{{this.description}}{{#if this.url}} <a href="{{this.url}}" style="color:#4299e1;font-size:12px;text-decoration:none;">↗</a>{{/if}}{{#if this.breadcrumb_text}} <span style="color:#a0aec0;font-size:12px;">({{this.breadcrumb_text}})</span>{{/if}}</li>
        {{/each}}
      {{else if this.items}}
        {{#each this.items}}
        <li>{{this}}</li>
        {{/each}}
      {{/if}}
    </ul>
    {{/each}}
  {{else}}
    <p class="empty-note">No activities captured today.</p>
  {{/if}}

  <h2>🎯 My Priorities Today</h2>
  {{#if priorities.length}}
    {{#each priorities}}
    {{#if this.description}}
    <div class="priority-item" style="border-left-color: {{#if (eq this.urgency 'red')}}#e53e3e{{else if (eq this.urgency 'yellow')}}#d69e2e{{else}}#4299e1{{/if}};">
      {{#if (eq this.urgency 'red')}}🔴{{else if (eq this.urgency 'yellow')}}🟡{{else}}🔵{{/if}}
      {{this.description}}
      {{#if this.url}} <a href="{{this.url}}" style="color:#4299e1;font-size:12px;text-decoration:none;">↗</a>{{/if}}{{#if this.breadcrumb_text}} <span style="color:#a0aec0;font-size:12px;">({{this.breadcrumb_text}})</span>{{/if}}
      {{#if this.reason}}<br><span style="color:#a0aec0;font-size:12px;">{{this.reason}}</span>{{/if}}
    </div>
    {{else}}
    <div class="priority-item">{{this}}</div>
    {{/if}}
    {{/each}}
  {{else}}
    <p class="empty-note">No priorities identified.</p>
  {{/if}}

  <h2>⏳ Left Unfinished</h2>
  {{#if unfinished.length}}
    {{#each unfinished}}
    {{#if this.item}}
    <div class="unfinished-item">{{this.item}}{{#if this.origin_date}} <span style="color:#a0aec0;font-size:12px;">(since {{this.origin_date}})</span>{{/if}}</div>
    {{else}}
    <div class="unfinished-item">{{this}}</div>
    {{/if}}
    {{/each}}
  {{else}}
    <p class="empty-note">Nothing left unfinished — nice!</p>
  {{/if}}

  <div class="footer">
    Generated by Dayarc · {{date}}
  </div>
</body>
</html>
